# Токен от @BotFather — обязательно
BOT_TOKEN=1234567890:AA...

# Имя бота в профиле Telegram (бот выставит его сам при запуске)
BOT_NAME=NeyroTokBot

# Ваш Telegram ID (узнать: @userinfobot). Через запятую можно несколько. Админам лимиты не действуют.
ADMIN_IDS=

# Адрес сайта генерации
SITE_URL=https://okroshka-su6j.onrender.com/

# browser — бот открывает сайт в Chromium и заполняет форму сам (по умолчанию)
# direct  — без браузера, те же запросы что делает кнопка сайта (для слабого хостинга)
ENGINE=browser

# Сколько видео генерировать одновременно (на бесплатном хостинге — 1)
MAX_PARALLEL=1

# Видео в сутки на одного человека, 0 = без лимита
DAILY_LIMIT=5

# Сколько заданий одновременно может держать в очереди один человек
MAX_ACTIVE_PER_USER=1

# Ограничить бота только этими чатами/каналами (ID через запятую). Пусто = публичный бот для всех.
ALLOWED_CHATS=

# В канале после публикации видео удалять служебные посты (команду, панель, статус)
CHANNEL_CLEANUP=1

# Значения по умолчанию в панели
DEFAULT_DURATION=5
DEFAULT_RATIO=16:9

# Вебхук. На Render задаётся сам (RENDER_EXTERNAL_URL). На другом хостинге впишите свой https-адрес.
# Если пусто — бот работает через long polling (VPS, свой ПК).
WEBHOOK_URL=
PORT=10000
